{
  "kind": "collectionType",
  "collectionName": "agendamentos",
  "info": {
    "singularName": "agendamento",
    "pluralName": "agendamentos",
    "displayName": "Agendamentos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "servico": {
      "type": "string",
      "required": true
    },
    "data": {
      "type": "date",
      "required": true
    },
    "hora": {
      "type": "time",
      "required": true
    },
    "valor": {
      "type": "integer",
      "required": true
    },
    "estagio": {
      "type": "enumeration",
      "required": true,
      "default": "pendente",
      "enum": [
        "pendente",
        "andamento",
        "concluido"
      ]
    },
    "pet": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::pet.pet"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "agendamentos"
    }
  }
}
