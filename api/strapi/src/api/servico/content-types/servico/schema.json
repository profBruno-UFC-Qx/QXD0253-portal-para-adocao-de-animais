      "unique": true
    },
    "valor": {
      "type": "decimal",
      "required": true
    },
    "especies": {
      "type": "enumeration",
      "required": true,
      "default": "Cão e Gato",
      "enum": [
        "Cão",
        "Gato",
        "Cão e Gato"
      ]
    },
    "descricao": {
      "type": "text",
      "required": true
    },
    "tempo": {
      "type": "integer",
      "required": true
    }
  }
}
