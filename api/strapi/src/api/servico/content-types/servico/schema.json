{
  "kind": "collectionType",
  "collectionName": "servicos",
  "info": {
    "singularName": "servico",
    "pluralName": "servicos",
    "displayName": "Servicos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
