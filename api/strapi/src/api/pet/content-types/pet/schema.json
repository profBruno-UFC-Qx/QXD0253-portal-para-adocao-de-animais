{
  "kind": "collectionType",
  "collectionName": "pets",
  "info": {
    "singularName": "pet",
    "pluralName": "pets",
    "displayName": "Pets"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "especie": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Cão",
        "Gato"
      ]
    },
    "raca": {
      "type": "string",
      "required": true
    },
    "porte": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Pequeno (até 10kg)",
        "Médio (10kg  25kg)",
        "Grande (acima de 25kg)"
      ]
    },
    "pelagem": {
      "type": "string",
      "required": true
    },
    "idade": {
      "type": "integer",
      "required": false
    },
    "observacoes": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true,
      "inversedBy": "pets"
    }
  }
}
